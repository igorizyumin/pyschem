<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <ref name="XSch"/>
  </start>
  <define name="Bool">
    <choice>
      <value>1</value>
      <value>0</value>
    </choice>
  </define>
  <define name="AlignHorizAttr">
    <attribute>
      <name ns="">hAlign</name>
      <choice>
        <value>left</value>
        <value>center</value>
        <value>right</value>
      </choice>
    </attribute>
  </define>
  <define name="AlignVertAttr">
    <attribute>
      <name ns="">vAlign</name>
      <choice>
        <value>top</value>
        <value>middle</value>
        <value>bottom</value>
      </choice>
    </attribute>
  </define>
  <define name="UuidStr">
    <data type="string">
      <param name="length">36</param>
    </data>
  </define>
  <define name="Uuid">
    <element>
      <name ns="">uuid</name>
      <ref name="UuidStr"/>
    </element>
  </define>
  <define name="Dimension">
    <data type="int">
      <param name="minInclusive">0</param>
    </data>
  </define>
  <define name="ObjID">
    <data type="int">
      <param name="minInclusive">0</param>
    </data>
  </define>
  <define name="Coord">
    <data type="int"/>
  </define>
  <define name="CoordsAttr">
    <group>
      <attribute>
        <name ns="">x</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">y</name>
        <ref name="Coord"/>
      </attribute>
    </group>
  </define>
  <define name="RotAttr">
    <attribute>
      <name ns="">rot</name>
      <choice>
        <value>0</value>
        <value>90</value>
        <value>180</value>
        <value>270</value>
      </choice>
    </attribute>
  </define>
  <define name="MirrorAttr">
    <attribute>
      <name ns="">mirror</name>
      <ref name="Bool"/>
    </attribute>
  </define>
  <define name="ArcDirAttr">
    <attribute>
      <name ns="">dir</name>
      <choice>
        <value>cw</value>
        <value>ccw</value>
      </choice>
    </attribute>
  </define>
  <define name="TextPosAttr">
    <group>
      <ref name="CoordsAttr"/>
      <ref name="RotAttr"/>
      <ref name="AlignHorizAttr"/>
      <ref name="AlignVertAttr"/>
    </group>
  </define>
  <define name="TextFormatAttr">
    <group>
      <attribute>
        <name ns="">fontFamily</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <name ns="">fontSize</name>
        <ref name="Dimension"/>
      </attribute>
    </group>
  </define>
  <define name="LineAttr">
    <group>
      <attribute>
        <name ns="">weight</name>
        <ref name="Dimension"/>
      </attribute>
      <attribute>
        <name ns="">x1</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">y1</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">x2</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">y2</name>
        <ref name="Coord"/>
      </attribute>
    </group>
  </define>
  <define name="NetAttr">
    <group>
      <attribute>
        <name ns="">x1</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">y1</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">x2</name>
        <ref name="Coord"/>
      </attribute>
      <attribute>
        <name ns="">y2</name>
        <ref name="Coord"/>
      </attribute>
    </group>
  </define>
  <define name="KeyValueProp">
    <element>
      <name ns="">prop</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <data type="string"/>
    </element>
  </define>
  <define name="PropertyTemplate">
    <element>
      <name ns="">prop</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <name ns="">editable</name>
          <ref name="Bool"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">visible</name>
          <ref name="Bool"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">required</name>
          <ref name="Bool"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">order</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <data type="string"/>
      </optional>
    </element>
  </define>
  <define name="PropertyOverride">
    <element>
      <name ns="">prop</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <data type="string"/>
    </element>
  </define>
  <define name="XSch">
    <element>
      <name ns="">xSchematic</name>
      <ref name="Properties"/>
      <optional>
        <ref name="Symbol"/>
      </optional>
      <optional>
        <ref name="Pages"/>
      </optional>
    </element>
  </define>
  <define name="Properties">
    <element>
      <name ns="">props</name>
      <ref name="Uuid"/>
      <zeroOrMore>
        <ref name="KeyValueProp"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Symbol">
    <element>
      <name ns="">symbol</name>
      <ref name="SymProps"/>
      <oneOrMore>
        <ref name="SymPart"/>
      </oneOrMore>
    </element>
  </define>
  <define name="SymProps">
    <element>
      <name ns="">props</name>
      <zeroOrMore>
        <ref name="KeyValueProp"/>
      </zeroOrMore>
      <zeroOrMore>
        <ref name="PinMap"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="PinMap">
    <element>
      <name ns="">pinMap</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <oneOrMore>
        <element>
          <name ns="">map</name>
          <attribute>
            <name ns="">part</name>
            <data type="string"/>
          </attribute>
          <attribute>
            <name ns="">from</name>
            <data type="string"/>
          </attribute>
          <attribute>
            <name ns="">to</name>
            <data type="string"/>
          </attribute>
        </element>
      </oneOrMore>
    </element>
  </define>
  <define name="SymPart">
    <element>
      <name ns="">symPart</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <element>
        <name ns="">props</name>
        <zeroOrMore>
          <ref name="PropertyTemplate"/>
        </zeroOrMore>
      </element>
      <element>
        <name ns="">objects</name>
        <zeroOrMore>
          <ref name="SymObject"/>
        </zeroOrMore>
      </element>
    </element>
  </define>
  <define name="SymObject">
    <choice>
      <ref name="Line"/>
      <ref name="Text"/>
      <ref name="PropText"/>
      <ref name="Pin"/>
    </choice>
  </define>
  <define name="Pin">
    <element>
      <name ns="">pin</name>
      <attribute>
        <name ns="">id</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <name ns="">desc</name>
        <data type="string"/>
      </attribute>
      <ref name="CoordsAttr"/>
      <ref name="RotAttr"/>
      <zeroOrMore>
        <ref name="PropText"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Line">
    <element>
      <name ns="">line</name>
      <ref name="LineAttr"/>
    </element>
  </define>
  <define name="Text">
    <element>
      <name ns="">text</name>
      <ref name="TextPosAttr"/>
      <ref name="TextFormatAttr"/>
      <data type="string"/>
    </element>
  </define>
  <define name="PropText">
    <element>
      <name ns="">proptext</name>
      <ref name="TextPosAttr"/>
      <ref name="TextFormatAttr"/>
      <attribute>
        <name ns="">visible</name>
        <ref name="Bool"/>
      </attribute>
      <attribute>
        <name ns="">showName</name>
        <ref name="Bool"/>
      </attribute>
      <attribute>
        <name ns="">prop</name>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="Pages">
    <element>
      <name ns="">pages</name>
      <zeroOrMore>
        <ref name="Page"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Page">
    <element>
      <name ns="">page</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <element>
        <name ns="">objects</name>
        <zeroOrMore>
          <ref name="SchObject"/>
        </zeroOrMore>
      </element>
    </element>
  </define>
  <define name="SchObject">
    <choice>
      <ref name="Line"/>
      <ref name="Text"/>
      <ref name="Part"/>
      <ref name="Net"/>
      <ref name="SheetRef"/>
    </choice>
  </define>
  <define name="Part">
    <element>
      <name ns="">part</name>
      <attribute>
        <name ns="">schPath</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <name ns="">partId</name>
        <data type="string"/>
      </attribute>
      <ref name="CoordsAttr"/>
      <ref name="RotAttr"/>
      <ref name="MirrorAttr"/>
      <optional>
        <element>
          <name ns="">props</name>
          <zeroOrMore>
            <ref name="PropertyOverride"/>
          </zeroOrMore>
        </element>
      </optional>
      <zeroOrMore>
        <ref name="PropText"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Net">
    <element>
      <name ns="">net</name>
      <ref name="NetAttr"/>
      <zeroOrMore>
        <ref name="PropText"/>
      </zeroOrMore>
      <zeroOrMore>
        <ref name="KeyValueProp"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="SheetRef">
    <element>
      <name ns="">sheetRef</name>
      <attribute>
        <name ns="">docPath</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <name ns="">pageName</name>
        <data type="string"/>
      </attribute>
      <ref name="CoordsAttr"/>
      <ref name="RotAttr"/>
      <ref name="MirrorAttr"/>
      <optional>
        <element>
          <name ns="">props</name>
          <zeroOrMore>
            <ref name="KeyValueProp"/>
          </zeroOrMore>
        </element>
      </optional>
      <optional>
        <element>
          <name ns="">ports</name>
          <zeroOrMore>
            <ref name="Port"/>
          </zeroOrMore>
        </element>
      </optional>
    </element>
  </define>
  <define name="Port">
    <element>
      <name ns="">port</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <name ns="">direction</name>
        <choice>
          <value>input</value>
          <value>output</value>
          <value>bidirectional</value>
          <value>passive</value>
          <value>uncertain</value>
        </choice>
      </attribute>
      <optional>
        <attribute>
          <name ns="">visible</name>
          <ref name="Bool"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">isBus</name>
          <ref name="Bool"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">width</name>
          <data type="int"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">startIndex</name>
          <data type="int"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">x</name>
          <ref name="Coord"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">y</name>
          <ref name="Coord"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="">nets</name>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>
</grammar>